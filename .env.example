# --- Supabase (Phase 1) ---------------------------------------------
# Leave both empty to run in DEMO MODE (no auth, labelled demo data).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Not used in Phase 1; required later for admin seeding scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anthropic (Phase 10, server-only) -------------------------------
ANTHROPIC_API_KEY=

# --- MQTT (Phase 11) ------------------------------------------------
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Email reminders (Phase 12) -------------------------------------
RESEND_API_KEY=
